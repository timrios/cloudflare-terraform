# Terraform's downloaded providers and modules; recreated by `terraform init`
.terraform/

# State can hold sensitive values and belongs to one machine or the remote backend, never git
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Variable files hold the API token and real values. Commit only *.tfvars.example
*.tfvars
*.tfvars.json
!*.tfvars.example

# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Backend settings with the Cloudflare account ID in the endpoint. Commit only the .example
backend.hcl

# Secrets
.env
.env.*
!.env.example

# The provider lock file (.terraform.lock.hcl) IS committed: it pins exact provider builds,
# but only the root configuration's (examples/basic). A module leaves versions to its caller.
modules/business-domain/.terraform.lock.hcl

# Folders made by ./new-domain for real domains. Everything in domains/ is ignored except its
# README, so a real zone ID or record can't be committed to this public repo by accident.
domains/*
!domains/README.md

.DS_Store
