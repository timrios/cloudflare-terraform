# Copy to .env in this folder (git-ignored) and fill in. This file holds what belongs to ONE
# domain. The values shared by every domain (token, R2 keys, bucket, endpoint) live in the .env
# at the repo root; see the root .env.example.

# The domain's Cloudflare zone ID (dashboard: the domain's Overview page, right-hand column).
# The TF_VAR_ prefix is how Terraform reads var.zone_id from the environment, and ./records
# reads the same value.
export TF_VAR_zone_id=

# Optional: a Cloudflare token limited to this one zone. Uncomment to use it instead of the
# shared token in the root .env.
# export CLOUDFLARE_API_TOKEN=
