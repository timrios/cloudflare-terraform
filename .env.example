# Copy to .env (git-ignored) and fill in. Names only here, never values.

# Cloudflare API token for the provider, limited to the one zone. Permissions: DNS (Edit),
# Zone (Read), Zone Settings (Edit), Single Redirect (Read and Edit).
export CLOUDFLARE_API_TOKEN=

# R2 S3-style credentials for the remote state bucket (created under R2 > Manage API tokens).
# The s3 backend reads these standard AWS names; they are not the Cloudflare token above.
export AWS_ACCESS_KEY_ID=
export AWS_SECRET_ACCESS_KEY=
