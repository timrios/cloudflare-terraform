# Copy to .env (git-ignored) and fill in. Names only here, never values.
# This file holds what is SHARED by every domain. Each domain's own zone ID goes in that
# domain's folder, in its own .env (see examples/basic/.env.example).

# Cloudflare API token for the provider. Permissions: DNS (Edit), Zone (Read), Zone Settings
# (Edit), Single Redirect (Read and Edit). A domain's own .env can override it with a token
# limited to that one zone.
export CLOUDFLARE_API_TOKEN=

# R2 S3-style credentials for the remote state bucket (created under R2 > Manage API tokens).
# The s3 backend reads these standard AWS names; they are not the Cloudflare token above.
export AWS_ACCESS_KEY_ID=
export AWS_SECRET_ACCESS_KEY=

# The R2 bucket that holds the state. ./tf passes it to `terraform init`, because the s3
# backend has no environment variable for the bucket name.
export TF_STATE_BUCKET=

# R2's S3 address: https://<ACCOUNT_ID>.r2.cloudflarestorage.com (the account ID is on the R2
# overview page, right-hand column).
export AWS_ENDPOINT_URL_S3=
